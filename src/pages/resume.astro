---
import { EMAIL, GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import { certifications, education, experience, location, skills, summary } from '../data/resume';
import Base from '../layouts/Base.astro';

const bareUrl = (url: string) => url.replace(/^https:\/\/(www\.)?/, '');
---

<Base title="Résumé" description={`Résumé of ${SITE_TITLE}, covering clinical data standards, FHIR and OMOP, and clinical AI evaluation.`} narrow>
	<header class="resume-header">
		<h1>{SITE_TITLE}</h1>
		<p class="meta contact">
			<span>{location}</span>
			<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
			<a href={LINKEDIN_URL}>{bareUrl(LINKEDIN_URL)}</a>
			<a href={GITHUB_URL}>{bareUrl(GITHUB_URL)}</a>
		</p>
		<button type="button" class="print" onclick="window.print()">Print or save as PDF</button>
	</header>

	<section aria-labelledby="summary">
		<h2 id="summary">Summary</h2>
		<p>{summary}</p>
	</section>

	<section aria-labelledby="experience">
		<h2 id="experience">Professional experience</h2>
		{
			experience.map((role) => (
				<div class="role">
					<h3>{role.title}</h3>
					<p class="org">
						{role.org}
						{role.unit && <span class="muted">, {role.unit}</span>}
					</p>
					<p class="meta when">
						{role.location && <span>{role.location}</span>}
						<span>{role.dates}</span>
					</p>
					<ul>
						{role.bullets.map((bullet) => (
							<li>{bullet}</li>
						))}
					</ul>
				</div>
			))
		}
	</section>

	<section aria-labelledby="skills">
		<h2 id="skills">Skills</h2>
		<dl>
			{
				skills.map((skill) => (
					<>
						<dt>{skill.label}</dt>
						<dd>{skill.items}</dd>
					</>
				))
			}
		</dl>
	</section>

	<section aria-labelledby="education">
		<h2 id="education">Education</h2>
		<ul class="plain">
			{
				education.map((entry) => (
					<li>
						<span class="degree">{entry.degree}</span>, {entry.school}
					</li>
				))
			}
		</ul>
	</section>

	<section aria-labelledby="certifications">
		<h2 id="certifications">Certifications</h2>
		<ul class="plain">
			{certifications.map((cert) => <li>{cert}</li>)}
		</ul>
	</section>
</Base>
<style>
	.resume-header {
		margin-bottom: 1rem;
	}
	.contact {
		margin-bottom: 1rem;
	}
	.print {
		height: 2rem;
		padding: 0 0.75rem;
		background: var(--surface);
		color: var(--text);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font: inherit;
		font-size: 0.875rem;
		cursor: pointer;
		transition: border-color 150ms var(--ease);
	}
	.print:hover {
		border-color: var(--accent);
	}
	h2 {
		margin-top: 2rem;
		padding-bottom: 0.25rem;
		border-bottom: 1px solid var(--border);
	}
	.role {
		margin-top: 1.25rem;
	}
	.role h3 {
		margin-bottom: 0;
		font-size: 1.0625rem;
	}
	.org {
		margin: 0;
	}
	.when {
		margin: 0.25rem 0 0.5rem;
	}
	.role ul {
		padding-left: 1.25rem;
	}
	.role li {
		margin-bottom: 0.25rem;
	}
	dl {
		margin: 0;
	}
	dt {
		margin-top: 0.75rem;
		font-weight: 500;
	}
	dd {
		margin: 0;
	}
	.plain {
		list-style: none;
		padding: 0;
	}
	.plain li {
		margin-bottom: 0.25rem;
	}
	.degree {
		font-weight: 500;
	}

	@media print {
		:global(header:not(.resume-header)),
		:global(footer),
		:global(.skip-link),
		.print {
			display: none;
		}
		a {
			color: #000;
			text-decoration: none;
		}
		/* The global stylesheet loads after this one, so these selectors carry extra weight to beat its print rules. */
		:global(html:root) {
			font-size: 9.5pt;
		}
		:global(html body) {
			line-height: 1.35;
		}
		.resume-header {
			margin-bottom: 0.25rem;
		}
		h2 {
			margin: 0.625rem 0 0.375rem;
			break-after: avoid;
		}
		/* A role may continue on the next page, but its title, employer and dates stay with its first bullet. */
		.role {
			margin-top: 0.5rem;
		}
		.role h3,
		.org,
		.when {
			break-after: avoid;
		}
		.role li {
			break-inside: avoid;
		}
		.when {
			margin: 0.125rem 0 0.25rem;
		}
		.role ul {
			margin-bottom: 0;
		}
		.role li {
			margin-bottom: 0.125rem;
		}
		/* Each skill label sits beside its list on paper, as in the résumé document, to save a line per skill. */
		dl {
			display: grid;
			grid-template-columns: max-content minmax(0, 1fr);
			gap: 0.125rem 1rem;
		}
		dt,
		dd {
			margin: 0;
		}
		.plain li {
			margin-bottom: 0.125rem;
		}
	}
</style>
