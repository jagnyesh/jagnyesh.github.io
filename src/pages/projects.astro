---
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import Base from '../layouts/Base.astro';
---

<Base
	title="Projects"
	description="Projects on clinical data and AI-assisted development, each with the question it asked and the answer."
	narrow
>
	<h1>Projects</h1>
	<p class="lede">
		Each project starts from a question, and its README reports the answer, even when the answer went against my
		hypothesis. All of them run on synthetic or public data.
	</p>
	<ul>
		{projects.map((project) => <ProjectCard project={project} variant="detailed" />)}
	</ul>
</Base>
<style>
	ul {
		display: grid;
		gap: 1rem;
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
	}
</style>
