---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	variant?: 'compact' | 'lead' | 'detailed';
}

const { project, variant = 'compact' } = Astro.props;
// The projects page lists cards straight under its h1; the home page nests them under an h2.
const Heading = variant === 'detailed' ? 'h2' : 'h3';
// Home cards open the project's entry on this site, so readers see the finding before leaving for GitHub.
const linked = variant !== 'detailed';
const result = variant === 'compact' ? project.finding : project.result;
---

<li class:list={['card', variant, { linked }]} id={project.name}>
	<div class="head">
		<Heading class="name">{linked ? <a href={`/projects/#${project.name}`}>{project.name}</a> : project.name}</Heading>
		<p class="question">{project.question}</p>
	</div>
	<div class="body">
		{variant === 'detailed' && <p>{project.summary}</p>}
		{result && <p class="result">{result}</p>}
		<p class="meta">
			<span>{project.language}</span>
			<a href={project.repo}>Code</a>
			{project.demo && <a href={project.demo.url}>{project.demo.label}</a>}
		</p>
	</div>
</li>
<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: border-color 150ms var(--ease);
	}
	.linked:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}
	.name {
		margin: 0 0 0.25rem;
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 500;
	}
	.name a {
		color: inherit;
		text-decoration: none;
	}
	.linked:hover .name a {
		color: var(--accent);
		text-decoration: underline;
	}
	/* Make the whole card open the project's entry; the Code and demo links sit above this layer. */
	.name a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	.meta a {
		position: relative;
		z-index: 1;
	}
	.question {
		margin: 0;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: auto;
	}
	.body p {
		margin: 0;
	}
	.result,
	.detailed .body p:not(.meta) {
		color: var(--secondary);
		font-size: 0.9375rem;
	}
	.lead .question,
	.detailed .question {
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.45;
	}
	.lead {
		padding: 1.5rem;
	}
	@media (min-width: 48rem) {
		.lead {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 2rem;
		}
		.lead .body {
			margin-top: 0;
		}
	}
</style>
