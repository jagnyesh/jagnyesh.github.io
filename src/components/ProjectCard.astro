---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	detailed?: boolean;
}

const { project, detailed = false } = Astro.props;
// The projects page lists cards straight under its h1; the home page nests them under an h2.
const Heading = detailed ? 'h2' : 'h3';
---

<li class="card" id={project.name}>
	<Heading class="name"><a href={project.repo}>{project.name}</a></Heading>
	<p class="question">{project.question}</p>
	{
		detailed && (
			<>
				<p>{project.summary}</p>
				<p>{project.result}</p>
			</>
		)
	}
	<p class="meta">
		<span>{project.language}</span>
		<a href={project.repo}>Code</a>
		{project.demo && <a href={project.demo.url}>{project.demo.label}</a>}
	</p>
</li>
<style>
	.card {
		display: flex;
		flex-direction: column;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.name {
		margin-top: 0;
	}
	.name a {
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 1rem;
		text-decoration: none;
	}
	.name a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.question {
		font-family: var(--font-serif);
		font-size: 1.0625rem;
	}
	p {
		font-size: 0.9375rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: auto 0 0;
		padding-top: 0.5rem;
		color: var(--muted);
		font-size: 0.875rem;
	}
</style>
