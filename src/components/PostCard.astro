---
import { type Post, readingMinutes } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<li class="card">
	<h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
	<p class="meta"><FormattedDate date={post.data.pubDate} /> · {readingMinutes(post)} min read</p>
	<p>{post.data.description}</p>
</li>
<style>
	.card {
		position: relative;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.card:hover {
		border-color: var(--accent);
	}
	h3 a {
		color: var(--text);
		text-decoration: none;
	}
	/* Make the whole card clickable while keeping one link in the accessibility tree. */
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.meta {
		margin-bottom: 0.5rem;
		color: var(--muted);
		font-size: 0.875rem;
	}
	p:last-child {
		margin: 0;
		font-size: 0.9375rem;
	}
</style>
